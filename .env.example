# Local HTTP example. Generate a secret before starting the app (see README).
LINK_SHORTENER_IMAGE=ghcr.io/sjtrny/link-shortener:latest
LINK_SHORTENER_DATA_VOLUME=link-shortener-data

DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Public HTTP(S) origin for copied links and QR codes. Empty uses the current request.
SHORTLINK_BASE_URL=http://localhost:8000

# These HTTP overrides are for localhost only. Use True for all three with HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Comma-separated proxy source IPs, only if a controlled HTTPS proxy is in use.
FORWARDED_ALLOW_IPS=

# Optional one-time bootstrap: set all three, or leave all three empty.
# Prefer the interactive createsuperuser command. Never commit a real password.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
